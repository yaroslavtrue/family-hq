# ── Telegram instance (existing `app` service) — unchanged ──
BOT_TOKEN=your_token_from_botfather
WEBAPP_URL=https://myfamilybusiness.duckdns.org
TZ=Europe/Belgrade
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
TRELLO_BOARD_ID=your_board_id
TRELLO_FAMILY_ID=1

# ── Product instance (`product` service, AUTH_MODE=accounts) ──
# Fill these to launch the email/Google product app on its own domain.
PRODUCT_SESSION_SECRET=generate_a_long_random_string_and_keep_it_stable
PRODUCT_PUBLIC_BASE_URL=https://your-product-domain.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Family HQ <noreply@your-product-domain.com>
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# PRODUCT_BOT_TOKEN is optional (defaults to a non-Telegram placeholder).
# Push notifications (FCM) — product only. FCM_PROJECT_ID = Firebase project id.
# Put the service-account key at ./data-product/fcm-sa.json (mounted to /data) and
# point FCM_SA_PATH at it. Leave both unset to disable push (no-op). See mobile/FIREBASE_FCM_RU.md.
FCM_PROJECT_ID=moya-family
FCM_SA_PATH=/data/fcm-sa.json
