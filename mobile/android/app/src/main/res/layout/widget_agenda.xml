<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Top bar: brand + manual sync -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Moya"
            android:textColor="#F2631C"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻"
            android:textSize="19sp"
            android:textColor="#F2631C"
            android:paddingLeft="6dp"
            android:paddingRight="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <ProgressBar
            android:id="@+id/widget_sync_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"
            android:indeterminate="true"
            android:indeterminateTint="#F2631C"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Week strip (Mon–Sun of the current week; today is circled) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/wd0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#80705F" />
            <TextView android:id="@+id/wn0" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:textSize="13sp" android:textColor="#2A1D12" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/wd1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#80705F" />
            <TextView android:id="@+id/wn1" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:textSize="13sp" android:textColor="#2A1D12" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/wd2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#80705F" />
            <TextView android:id="@+id/wn2" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:textSize="13sp" android:textColor="#2A1D12" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/wd3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#80705F" />
            <TextView android:id="@+id/wn3" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:textSize="13sp" android:textColor="#2A1D12" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/wd4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#80705F" />
            <TextView android:id="@+id/wn4" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:textSize="13sp" android:textColor="#2A1D12" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/wd5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#80705F" />
            <TextView android:id="@+id/wn5" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:textSize="13sp" android:textColor="#2A1D12" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/wd6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#80705F" />
            <TextView android:id="@+id/wn6" android:layout_width="24dp" android:layout_height="24dp" android:gravity="center" android:textSize="13sp" android:textColor="#2A1D12" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider (TextView, not a bare View — widgets don't support <View>) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14000000"
        android:layout_marginBottom="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/agenda_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/agenda_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Nothing coming up"
            android:textColor="#80705F"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
